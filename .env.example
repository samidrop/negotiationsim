# Copy this file to ".env" and put your real key in it.
#
#     cp .env.example .env
#
# ".env" is listed in .gitignore, so it is never committed or pushed.
# The example file you are reading is safe to commit: it holds no real key.

# Your Anthropic API key, from https://console.anthropic.com
# Without it the game still plays perfectly using its written dialogue.
ANTHROPIC_API_KEY=

# Optional. Which model writes the characters' lines.
NEGOSIM_MODEL=claude-opus-5

# Optional. Set to 1 to force the written dialogue even if a key is present.
NEGOSIM_NO_LLM=
